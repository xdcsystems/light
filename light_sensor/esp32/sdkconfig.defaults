# ESP32-WROOM-32 30-pin, CH340C UART, 40 MHz crystal, typical 4 MB flash.
# Overlay only — do not dump a full sdkconfig here (IDF 6 dump pins 2MB / 160 MHz).
# Local sdkconfig is generated by idf.py and gitignored.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BT_ENABLED=n

# Wi-Fi / controller: ESP-IDF Kconfig (menuconfig), not C++ literals.
# Leave SSID/PASS empty in git. Set locally in sdkconfig (gitignored).
CONFIG_LIGHT_SENSOR_WIFI_SSID=""
CONFIG_LIGHT_SENSOR_WIFI_PASS=""
CONFIG_LIGHT_SENSOR_CONTROLLER_IP="192.168.1.1"
CONFIG_LIGHT_SENSOR_CONTROLLER_PORT=5005
